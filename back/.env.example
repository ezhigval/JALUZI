# Server
PORT=3001
NODE_ENV=development
PROCESS_ROLE=all
CORS_ORIGIN=http://localhost:4321,http://127.0.0.1:4321
API_URL=http://localhost:3001
PUBLIC_API_BASE_URL=http://localhost:3001

# Storage
# Local: leave empty to use back/data and back/src/uploads
# Yandex Cloud VM: STORAGE_DIR=/var/data/jaluzi
STORAGE_DIR=

# Locally api.telegram.org usually works. On the RU VM use the Cloudflare Worker URL.
TELEGRAM_API_ROOT=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_PASSWORD=

# Email - исходящая. Почта остаётся на REG.RU.
EMAIL_HOST=mail.hosting.reg.ru
EMAIL_PORT=465
EMAIL_USER=info@piter-jaluzi.ru
EMAIL_PASS=

# Email - входящая
INCOMING_EMAIL_HOST=mail.hosting.reg.ru
INCOMING_EMAIL_PORT=993
INCOMING_EMAIL_USER=info@piter-jaluzi.ru
INCOMING_EMAIL_PASS=
