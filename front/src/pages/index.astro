---
import BaseLayout from '../layouts/BaseLayout.astro';
import OrderModal from '../components/ui/OrderModal.astro';
import Header from '../components/layout/Header.astro';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import CatalogPreview from '../components/sections/CatalogPreview.astro';
import Repair from '../components/sections/Repair.astro';
import About from '../components/sections/About.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import Footer from '../components/layout/Footer.astro';
import config from '../data/config.json';
---
<BaseLayout
  title={config.seo.title}
  description={config.seo.description}
  canonical="/"
>
  <OrderModal />
  <Header />
  <Hero />
  <Features />
  <CatalogPreview />
  <Repair />
  <About />
  <ContactForm />
  <Footer />
</BaseLayout>
