---
import config from '../../data/config.json';

const waDigits = config.messengers?.whatsapp || config.company.phone.replace(/\D/g, '');
const waText = encodeURIComponent(config.messengers?.whatsappText || 'Здравствуйте!');
const waUrl = `https://wa.me/${waDigits}?text=${waText}`;
const tgUrl = config.messengers?.telegram || 'https://t.me/';
---
<div id="sticky-cta" class="sticky-cta" aria-label="Быстрые действия">
  <a href={waUrl} class="sticky-cta-btn sticky-cta-wa" target="_blank" rel="noopener noreferrer">WhatsApp</a>
  <a href={tgUrl} class="sticky-cta-btn sticky-cta-tg" target="_blank" rel="noopener noreferrer">Telegram</a>
  <button type="button" data-open-order-modal class="sticky-cta-btn sticky-cta-order">Заявка</button>
</div>

<style>
  .sticky-cta {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 45;
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
    background: rgba(255, 255, 255, 0.98);
    border-top: 1px solid #E2E8F0;
    box-shadow: 0 -4px 20px rgba(15, 23, 42, 0.08);
    gap: 0.5rem;
  }

  .sticky-cta-btn {
    flex: 1;
    min-height: 48px;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.85rem;
    text-align: center;
    text-decoration: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sticky-cta-wa,
  .sticky-cta-tg {
    background: #fff;
    color: var(--color-primary);
    border: 2px solid #E2E8F0;
  }

  .sticky-cta-order {
    background: var(--color-primary);
    color: #fff;
  }

  @media (max-width: 768px) {
    .sticky-cta {
      display: flex;
    }

    body {
      padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
