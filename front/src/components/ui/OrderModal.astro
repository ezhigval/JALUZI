---
import config from '../../data/config.json';
---
<div id="order-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="order-modal-title">
  <div class="modal-content">
    <button id="order-modal-close" class="modal-close-btn" type="button" aria-label="Закрыть">×</button>
    <div class="modal-header">
      <h2 id="order-modal-title">Заказать жалюзи</h2>
      <p>Оставьте заявку и мы перезвоним</p>
    </div>
    <form id="order-form" class="modal-body">
      <label class="sr-only" for="order-name">Ваше имя</label>
      <input id="order-name" type="text" name="name" placeholder="Ваше имя" required class="modal-input" autocomplete="name" />
      <label class="sr-only" for="order-phone">Телефон</label>
      <input id="order-phone" type="tel" name="phone" placeholder="Телефон" required class="modal-input" autocomplete="tel" inputmode="tel" />
      <label class="sr-only" for="order-blinds-type">Тип жалюзи</label>
      <select id="order-blinds-type" name="blindsType" required class="modal-input modal-select">
        <option value="" disabled selected>Тип жалюзи</option>
        <option value="Рулонные">Рулонные</option>
        <option value="Вертикальные">Вертикальные</option>
        <option value="Горизонтальные">Горизонтальные</option>
        <option value="Другое">Другое</option>
      </select>
      <label class="sr-only" for="order-message">Комментарий</label>
      <textarea id="order-message" name="message" rows="3" placeholder="Комментарий" class="modal-textarea"></textarea>
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="order-honeypot" />
      <button type="submit" class="btn btn-primary">Отправить заявку</button>
      <p id="order-form-status" class="form-status" aria-live="polite"></p>
    </form>
    <div class="modal-footer">
      <p>📞 {config.company.phone}</p>
      <p>📍 {config.company.address}</p>
    </div>
  </div>
</div>

<style>
  .order-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
</style>
