---
import config from '../../data/config.json';

const pricing = config.pricing?.fromPerSqm ?? {};
const categories = Object.keys(pricing).filter((key) => key !== 'default');
const defaultPrice = Number(pricing['default']) || 890;
const minPrice = categories.length
  ? Math.min(...categories.map((key) => Number(pricing[key]) || defaultPrice))
  : defaultPrice;
---
<section id="prices" class="section">
  <div class="container" style="max-width:720px;">
    <h2 class="section-title">Цены от {minPrice} ₽/м²</h2>
    <p class="price-lead">
      Ориентир по категориям. Точная стоимость — после бесплатного замера.
    </p>
    <div class="price-calculator">
      <ul class="price-list">
        {categories.map((category) => (
          <li class="price-item">
            <span class="price-category">{category}</span>
            <span class="price-value">от {pricing[category]} ₽/м²</span>
          </li>
        ))}
      </ul>
      <button type="button" data-open-order-modal class="btn btn-primary" style="width:100%;margin-top:1rem;">
        Вызвать замерщика
      </button>
    </div>
  </div>
</section>

<style>
  .price-lead {
    text-align: center;
    color: var(--color-text-muted);
    margin: -1rem 0 1.5rem;
  }

  .price-calculator {
    background: #fff;
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: var(--shadow-md);
  }

  .price-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .price-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid #E2E8F0;
  }

  .price-item:last-child {
    border-bottom: none;
  }

  .price-category {
    font-weight: 600;
    color: var(--color-text);
  }

  .price-value {
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
  }
</style>
