---
import config from '../../data/config.json';
---
<section class="hero-section" style="min-height:clamp(500px, 70vh, 800px);display:flex;align-items:center;justify-content:center;padding:4rem 1.5rem;position:relative;">
  <picture class="hero-bg" aria-hidden="true">
    <source srcset="/background.webp" type="image/webp" />
    <img src="/background.jpg" alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
  </picture>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div style="text-align:center;color:white;padding:1.5rem;max-width:700px;position:relative;z-index:1;">
    <h1 style="font-size:clamp(1.75rem, 5vw, 2.5rem);margin-bottom:1rem;line-height:1.2;font-weight:700;">Жалюзи на заказ за 3 дня</h1>
    <p style="font-size:clamp(1rem, 3vw, 1.25rem);margin-bottom:2rem;opacity:0.95;">Бесплатный замер и гарантия {config.company.warranty}</p>
    <button data-open-order-modal style="display:inline-block;padding:1rem 2rem;background:white;color:#2563EB;border:none;border-radius:0.5rem;font-weight:600;font-size:1.1rem;box-shadow:0 4px 15px rgba(0,0,0,0.3);transition:transform 0.3s;cursor:pointer;">Вызвать замерщика</button>
  </div>
</section>

<style>
  .hero-section {
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(to bottom, rgba(15, 23, 42, 0.45), rgba(15, 23, 42, 0.35));
  }

  @media (max-width: 768px) {
    .hero-section {
      min-height: 500px;
      padding: 3rem 1rem;
      padding-top: calc(var(--header-height, 4.5rem) + 2rem);
    }

    .hero-bg img {
      object-position: center 30%;
    }
  }

  @media (max-width: 480px) {
    .hero-section {
      min-height: 450px;
    }

    .hero-bg img {
      object-position: center 40%;
    }
  }
</style>
