# Copy to .env on the Yandex Cloud VM. Never commit the real file.

NODE_ENV=production
PORT=3001

# Public site. Empty PUBLIC_API_URL = same-origin /api and /uploads.
SITE_URL=https://piter-jaluzi.ru
PUBLIC_API_URL=
PUBLIC_API_BASE_URL=https://piter-jaluzi.ru
API_URL=https://piter-jaluzi.ru
CORS_ORIGIN=https://piter-jaluzi.ru,https://www.piter-jaluzi.ru
STORAGE_DIR=/var/data/jaluzi

# Let's Encrypt account email for Caddy
ACME_EMAIL=info@piter-jaluzi.ru

# Telegram via Cloudflare Worker proxy (required from RU Yandex Cloud VM)
# Deploy deploy/cloudflare/telegram-proxy-worker.js, then paste the workers.dev URL:
TELEGRAM_API_ROOT=https://piter-jaluzi-tg-proxy.YOUR_SUBDOMAIN.workers.dev
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_PASSWORD=

# Mail stays on REG.RU. Do not move MX records to the VM.
EMAIL_HOST=mail.hosting.reg.ru
EMAIL_PORT=465
EMAIL_USER=info@piter-jaluzi.ru
EMAIL_PASS=
EMAIL_SECURE=true
INCOMING_EMAIL_HOST=mail.hosting.reg.ru
INCOMING_EMAIL_PORT=993
INCOMING_EMAIL_USER=info@piter-jaluzi.ru
INCOMING_EMAIL_PASS=
