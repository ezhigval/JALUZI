# Copy to .env on the Yandex Cloud VM. Never commit the real file.

COMPOSE_PROJECT_NAME=piter-jaluzi
NODE_ENV=production
PORT=3001
# PROCESS_ROLE is overridden per-service in docker-compose.yml (api / worker).
PROCESS_ROLE=api

# Public site. Empty PUBLIC_API_URL = same-origin /api and /uploads.
SITE_URL=https://piter-jaluzi.ru
PUBLIC_API_URL=
PUBLIC_API_BASE_URL=https://piter-jaluzi.ru
API_URL=https://piter-jaluzi.ru
CORS_ORIGIN=https://piter-jaluzi.ru,https://www.piter-jaluzi.ru
STORAGE_DIR=/var/data/jaluzi

# Let's Encrypt account email for Caddy
ACME_EMAIL=info@piter-jaluzi.ru

# Search Console / Yandex Webmaster (baked into web image at build)
# Meta tags also fall back to front/src/data/config.json values.
PUBLIC_GOOGLE_SITE_VERIFICATION=RzOr3qSIZmj2wbA6FUUh9JAW5v1ZaC0N1PGl1OZz0wc
PUBLIC_YANDEX_VERIFICATION=132f0d56d1d3cf89
# Optional analytics
PUBLIC_YANDEX_METRIKA_ID=111985236
PUBLIC_GA_MEASUREMENT_ID=

# Telegram via Cloudflare Worker proxy (required from a RU Yandex Cloud VM).
# Deploy: cd deploy/cloudflare && npx wrangler deploy
TELEGRAM_API_ROOT=https://piter-jaluzi-tg-proxy.chemical-red.workers.dev
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_PASSWORD=
# webhook (prod) | polling (local/dev fallback)
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# Outbound order mail → Mailpit (in compose). UI: ssh -L 8025:127.0.0.1:8025 …
# To switch back to REG.RU SMTP later: EMAIL_HOST=mail.hosting.reg.ru EMAIL_PORT=465 EMAIL_SECURE=true
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USER=orders@piter-jaluzi.local
EMAIL_PASS=
EMAIL_SECURE=false

# IMAP listener off while using Mailpit (no real mailbox). Clear host/pass to disable.
INCOMING_EMAIL_HOST=
INCOMING_EMAIL_PORT=993
INCOMING_EMAIL_USER=
INCOMING_EMAIL_PASS=

# Autodeploy / ops hook (POST /internal/deploy with Authorization: Bearer …)
# Generate: openssl rand -hex 32
DEPLOY_HOOK_SECRET=

# Git remote the VM watches (systemd timer). Default: origin/main of the clone.
AUTODEPLOY_REMOTE=origin
AUTODEPLOY_BRANCH=main
