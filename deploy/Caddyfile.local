{
	auto_https off
}

:80 {
	encode gzip

	@publicApi path /api /api/ /api/products* /api/orders* /api/reviews*
	handle @publicApi {
		reverse_proxy api:3001
	}

	handle /uploads/* {
		reverse_proxy api:3001
	}

	handle /health {
		reverse_proxy api:3001
	}

	handle {
		root * /srv
		try_files {path} {path}/ {path}.html
		file_server
	}
}
