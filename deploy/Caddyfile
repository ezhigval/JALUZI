{
	email {$ACME_EMAIL}
}

www.piter-jaluzi.ru {
	redir https://piter-jaluzi.ru{uri} permanent
}

piter-jaluzi.ru {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@publicApi path /api /api/ /api/products* /api/orders* /api/reviews*
	handle @publicApi {
		reverse_proxy api:3001
	}

	# Telegram Bot API webhook (TELEGRAM_MODE=webhook)
	handle /telegram/* {
		reverse_proxy api:3001
	}

	handle /internal/* {
		reverse_proxy api:3001
	}

	handle /uploads/* {
		reverse_proxy api:3001
	}

	handle /health {
		reverse_proxy api:3001
	}

	handle {
		root * /srv
		try_files {path} {path}/ {path}.html
		file_server
	}
}
